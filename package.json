{
  "name": "bizziemoney",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "brand:verify": "node scripts/verify-brand-assets.mjs",
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present clean",
    "demo:seed": "pnpm --filter @bizziemoney/database demo:seed",
    "db:migrate": "pnpm --filter @bizziemoney/database migrate",
    "dev": "pnpm --parallel --filter @bizziemoney/web --filter @bizziemoney/api --filter @bizziemoney/worker dev",
    "dev:api": "pnpm --filter @bizziemoney/api dev",
    "dev:web": "pnpm --filter @bizziemoney/web dev",
    "dev:worker": "pnpm --filter @bizziemoney/worker dev",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "owner:recover": "pnpm --filter @bizziemoney/api owner:recover",
    "performance:verify": "pnpm --filter @bizziemoney/database performance:verify",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
