# Primary application origin and exact additional browser origins. Never use
# wildcards or include URL paths.
APP_URL=http://localhost:5173
APP_ALLOWED_ORIGINS=http://localhost:5173

# Vite development/preview access. Hostnames must be exact and omit protocols,
# ports, paths, and wildcards. Browser API calls remain same-origin at /api.
VITE_ALLOWED_HOSTS=
VITE_API_PROXY_TARGET=http://localhost:3001
# Leave empty for the recommended same-origin /api path.
VITE_API_URL=

# External PostgreSQL is the production default.
# On a Windows host from Docker, use host.docker.internal instead of localhost.
DATABASE_URL=postgresql://bizziemoney:change-me@localhost:5432/bizziemoney
# Used only by the optional Docker local-db profile.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Published release images. For Docker Hub pulls, set this to
# [DOCKERHUB_USERNAME]/bizziemoney. The local value works with `--build`.
BIZZIEMONEY_IMAGE=bizziemoney
BIZZIEMONEY_VERSION=1.0.0

# Service listeners
API_HOST=0.0.0.0
API_PORT=3001
WEB_PORT=5173
LOG_LEVEL=info
TZ=Asia/Riyadh

# Required for secure session hashing. Generate at least 32 random characters.
SESSION_SECRET=
SESSION_TTL_HOURS=168

# Attachment storage. Binary data stays outside PostgreSQL. These values are
# deployment defaults; the owner can override the active provider and S3/R2
# profile from Settings. ATTACHMENT_LOCAL_PATH always remains host-managed.
ATTACHMENT_STORAGE_PROVIDER=local
ATTACHMENT_LOCAL_PATH=/data/attachments
ATTACHMENT_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/webp,text/plain,text/csv
ATTACHMENT_CLEANUP_INTERVAL_MS=5000
MAX_UPLOAD_SIZE_MB=20
# Optional fail-closed ClamAV scanning. Start Compose with the malware-scan
# profile, then set the mode to clamav.
ATTACHMENT_MALWARE_SCANNER=disabled
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
# Production Compose bind mounts. Keep these on durable host storage.
ATTACHMENT_HOST_PATH=../.data/attachments
BACKUP_HOST_PATH=../.data/backups

# Subscription reminders and lifecycle maintenance.
SUBSCRIPTION_REMINDER_INTERVAL_MS=60000

# Authentication maintenance. Expired/revoked sessions and stale login
# rate-limit records are retained briefly for diagnosis, then pruned.
SESSION_MAINTENANCE_INTERVAL_MS=21600000
SESSION_RETENTION_DAYS=30

# Optional deployment-default S3-compatible storage (AWS S3, Cloudflare R2,
# MinIO, and similar). Settings can save an encrypted owner-controlled profile.
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_REGION=auto
ATTACHMENT_S3_ENDPOINT=
ATTACHMENT_S3_PREFIX=bizziemoney
ATTACHMENT_S3_FORCE_PATH_STYLE=false
ATTACHMENT_S3_ACCESS_KEY_ID=
ATTACHMENT_S3_SECRET_ACCESS_KEY=

# Automatic backup worker. The destination and schedule are configured in
# Settings; local artifacts are written beneath this host-mounted root.
BACKUP_LOCAL_PATH=/data/backups
BACKUP_JOB_INTERVAL_MS=5000
WORKER_HEARTBEAT_INTERVAL_MS=30000
# Optional separate key for sealing saved attachment/backup S3 credentials and
# archive passwords. Leave blank to derive this protection from SESSION_SECRET.
BACKUP_SECRETS_KEY=
