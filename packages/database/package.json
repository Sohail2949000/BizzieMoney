{
  "name": "@bizziemoney/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "migrate": "tsx src/cli.ts",
    "performance:verify": "tsx src/performance.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "kysely": "^0.29.4",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
