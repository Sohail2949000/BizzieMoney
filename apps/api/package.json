{
  "name": "@bizziemoney/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/local-entry.ts src/recover-owner.ts --format esm --platform node --sourcemap --clean",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/local-entry.ts",
    "owner:recover": "node dist/recover-owner.js",
    "start": "node dist/local-entry.js",
    "typecheck": "tsc --noEmit",
    "vercel-build": "pnpm --filter @bizziemoney/shared --filter @bizziemoney/database --filter @bizziemoney/storage build && pnpm run build"
  },
  "dependencies": {
    "@bizziemoney/database": "workspace:*",
    "@bizziemoney/shared": "workspace:*",
    "@bizziemoney/storage": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "^9.3.0",
    "@node-rs/argon2": "2.0.2",
    "fastify": "^5.10.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  }
}
