{
  "name": "@bizziemoney/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "brand:verify": "node ../../scripts/verify-brand-assets.mjs",
    "build": "pnpm brand:verify && tsc --noEmit && vite build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bizziemoney/shared": "workspace:*",
    "@bizziemoney/ui": "workspace:*",
    "@hookform/resolvers": "5.4.2",
    "@tanstack/react-query": "5.101.4",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "7.82.0",
    "react-router-dom": "^7.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4"
  }
}
