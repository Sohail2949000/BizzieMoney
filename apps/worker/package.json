{
  "name": "@bizziemoney/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform node --sourcemap --clean",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bizziemoney/database": "workspace:*",
    "@bizziemoney/shared": "workspace:*",
    "@bizziemoney/storage": "workspace:*",
    "zod": "^4.4.3"
  }
}
